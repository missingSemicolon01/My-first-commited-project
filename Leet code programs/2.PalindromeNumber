class Solution {
    public boolean isPalindrome(int x) {
        int reversed = 0;
        int temp = x;
        
        if (x < 0) {
            return false;
        }
        
        while (temp > 0) {
            reversed = reversed * 10 + temp % 10; 
            temp = temp / 10;
        }
        
        return reversed == x;
    }
}